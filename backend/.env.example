PROJECT_NAME="Darukaa.Earth Platform"
API_V1_STR="/api/v1"
SECRET_KEY="darukaa-super-secret-jwt-key-2025-geospatial-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL + PostGIS (production / Docker — REQUIRED for hackathon evaluation):
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/darukaa"

# SQLite fallback (local zero-config dev only — swap DATABASE_URL to use this):
# DATABASE_URL="sqlite:///./darukaa.db"

# ── Optional ─────────────────────────────────────────────────────────────────
# Mapbox backend token (can also be set directly in frontend/.env)
MAPBOX_ACCESS_TOKEN=""
